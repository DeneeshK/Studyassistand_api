APP_NAME=EduMind Study Assistant API
APP_ENV=development
HOST=0.0.0.0
PORT=8100

FRONTEND_ORIGIN=http://localhost:5173
CORE_API_URL=http://localhost:8000
STUDY_API_URL=http://localhost:8100

STORAGE_DIR=storage

GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant

# Optional proxy for YouTube caption requests (fixes YouTube blocking this
# server's IP as a bot). Example: http://user:pass@proxy-host:port
YOUTUBE_PROXY_URL=

WHISPER_MODEL=base.en
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=auto

MAX_UPLOAD_MB=200
AUDIO_CHUNK_SECONDS=5

CORS_ORIGINS=http://localhost:5173,http://localhost:3000